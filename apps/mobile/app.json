{
  "expo": {
    "name": "Vortex Visual Operations",
    "slug": "vortex-visual-operations",
    "scheme": "vortex",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vortex needs access to your photos to attach damage report images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.nuelsha.vortexvisualoperations",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    }
  }
}
